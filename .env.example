# Required for Clerk authentication
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_with_your_publishable_key
CLERK_SECRET_KEY=sk_test_replace_with_your_secret_key
CLERK_PUBLISHABLE_KEY=pk_test_replace_with_your_publishable_key
# Optional application configuration
# Set this to your Clerk user ID (user_...) to make the initial application owner an administrator.
# OWNER_OPEN_ID=user_replace_with_your_clerk_user_id
# Comma-separated Clerk user IDs to bootstrap manager access before administrator controls are implemented.
# MANAGER_OPEN_IDS=user_first_manager_id,user_second_manager_id
# DATABASE_URL=mysql://user:password@host:3306/fraudlens

# Private Supabase Storage bucket for organization-scoped evidence files.
# Keep the service-role key server-only: never commit it or expose it as a VITE_* value.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_server_only_service_role_key
SUPABASE_STORAGE_BUCKET=fraudlens-evidence

# Optional server-only Resend configuration for high-risk email alerts.
# Start with onboarding@resend.dev for limited testing; use a verified domain before production alerts.
RESEND_API_KEY=re_replace_with_your_resend_api_key
# RESEND_FROM_EMAIL=FraudLens Alerts <alerts@yourdomain.com>
# Slack and Microsoft Teams webhook URLs are organization-scoped database settings visible only to authorized workspace managers and administrators, never environment variables.

# PORT=3000
